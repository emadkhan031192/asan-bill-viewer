package __PACKAGE__

import android.view.View
import android.view.ViewGroup
import android.webkit.WebResourceError
import android.webkit.WebResourceRequest
import android.webkit.WebView
import android.webkit.WebViewClient
import android.graphics.pdf.PdfDocument
import io.flutter.embedding.android.FlutterActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel
import java.io.File
import java.io.FileOutputStream

/**
 * Adds a MethodChannel ("dev.asanbill/pdf", method "printUrlToPdf") that
 * renders a bill page in an offscreen WebView and captures it to a
 * paginated A4 PDF written straight into the app's private vault directory.
 *
 * No print dialog, no user interaction, no extra permissions, and only
 * public Android APIs (no reflection, no hidden APIs).
 * Installed by tools/patch_android.sh after `flutter create`.
 */
class MainActivity : FlutterActivity() {
    private val channel = "dev.asanbill/pdf"

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, channel)
            .setMethodCallHandler { call, result ->
                if (call.method == "printUrlToPdf") {
                    val url = call.argument<String>("url")
                    val fileName = call.argument<String>("fileName")
                    if (url.isNullOrEmpty() || fileName.isNullOrEmpty()) {
                        result.error("ARGS", "Missing url/fileName", null)
                    } else {
                        renderPdf(url, fileName, result)
                    }
                } else {
                    result.notImplemented()
                }
            }
    }

    private fun renderPdf(
        url: String,
        fileName: String,
        result: MethodChannel.Result
    ) {
        runOnUiThread {
            var webView: WebView? = null
            var done = false
            fun cleanup() {
                webView?.let {
                    (it.parent as? ViewGroup)?.removeView(it)
                    it.destroy()
                }
                webView = null
            }
            fun finishError(code: String, message: String?) {
                if (done) return
                done = true
                cleanup()
                result.error(code, message, null)
            }
            try {
                val view = WebView(this)
                webView = view
                view.settings.javaScriptEnabled = true
                view.settings.loadWithOverviewMode = true
                view.settings.useWideViewPort = true
                // Attached (1px) so layout and rendering actually run.
                val root = findViewById<ViewGroup>(android.R.id.content)
                root.addView(view, ViewGroup.LayoutParams(1, 1))

                view.webViewClient = object : WebViewClient() {
                    override fun onPageFinished(v: WebView, u: String) {
                        // Let late JS settle before capturing.
                        v.postDelayed({
                            if (done) return@postDelayed
                            done = true
                            try {
                                captureToPdf(v, fileName)
                                val file = File(File(filesDir, "vault"), fileName)
                                cleanup()
                                result.success(file.absolutePath)
                            } catch (e: Exception) {
                                cleanup()
                                result.error("RENDER_ERROR", e.message, null)
                            }
                        }, 1500)
                    }

                    override fun onReceivedError(
                        v: WebView,
                        request: WebResourceRequest,
                        error: WebResourceError
                    ) {
                        if (request.isForMainFrame) {
                            finishError("LOAD_FAILED", error.description?.toString())
                        }
                    }
                }
                view.loadUrl(url)
            } catch (e: Exception) {
                finishError("WEBVIEW_ERROR", e.message)
            }
        }
    }

    /**
     * Lays the WebView out at full content height and draws it slice by
     * slice onto A4 pages of a PdfDocument.
     */
    private fun captureToPdf(view: WebView, fileName: String) {
        // Render width (~150 dpi): crisp text without huge files.
        val pageWidthPx = 1240
        view.layoutParams = ViewGroup.LayoutParams(pageWidthPx, ViewGroup.LayoutParams.WRAP_CONTENT)
        view.measure(
            View.MeasureSpec.makeMeasureSpec(pageWidthPx, View.MeasureSpec.EXACTLY),
            View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED)
        )
        var contentHeightPx = (view.contentHeight * view.scale).toInt()
        if (contentHeightPx <= 0) contentHeightPx = 1754 // fallback: A4 ratio
        view.measure(
            View.MeasureSpec.makeMeasureSpec(pageWidthPx, View.MeasureSpec.EXACTLY),
            View.MeasureSpec.makeMeasureSpec(contentHeightPx, View.MeasureSpec.EXACTLY)
        )
        view.layout(0, 0, pageWidthPx, contentHeightPx)

        val pdfWidthPt = 595  // A4 at 72 dpi
        val pdfHeightPt = 842
        val scale = pdfWidthPt / pageWidthPx.toFloat()
        val sliceHeightPx = (pdfHeightPt / scale).toInt().coerceAtLeast(1)

        val document = PdfDocument()
        try {
            var y = 0
            var pageNumber = 1
            while (y < contentHeightPx) {
                val pageInfo =
                    PdfDocument.PageInfo.Builder(pdfWidthPt, pdfHeightPt, pageNumber).create()
                val page = document.startPage(pageInfo)
                page.canvas.save()
                page.canvas.scale(scale, scale)
                page.canvas.translate(0f, -y.toFloat())
                view.draw(page.canvas)
                page.canvas.restore()
                document.finishPage(page)
                y += sliceHeightPx
                pageNumber++
            }
            val dir = File(filesDir, "vault").apply { mkdirs() }
            FileOutputStream(File(dir, fileName)).use { out ->
                document.writeTo(out)
            }
        } finally {
            document.close()
        }
    }
}
